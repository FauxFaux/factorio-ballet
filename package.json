{
  "name": "faucalc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:analyze": "tsc -b && vite build --mode analyze",
    "deploy:snapshot": "npm run build && rsync -av --delete dist/ sek:/srv/ballet.goeswhere.com/snapshot-$(git rev-parse --short HEAD)/",
    "deploy": "npm run deploy:snapshot && rsync -av dist/ sek:/srv/ballet.goeswhere.com/",
    "format": "oxfmt",
    "lint": "concurrently 'npm:lint:format -s' 'npm:lint:eslint -s' 'npm:lint:types -s' 'npm:lint:hash-version -s'",
    "lint:format": "oxfmt --list-different",
    "lint:eslint": "eslint --cache --cache-location node_modules/.tmp/ .",
    "lint:types": "tsc -b",
    "lint:hash-version": "node scripts/check-hash-version.ts",
    "preview": "vite build && vite preview",
    "known-versions": "node scripts/known-versions.ts",
    "split-icons": "node scripts/split-icons.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3",
    "@primer/octicons-react": "^19",
    "fflate": "^0.8",
    "preact": "^10",
    "serialize-error": "^13",
    "ts-number-to-words": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@preact/preset-vite": "^2",
    "@testing-library/preact": "^3",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "concurrently": "^10",
    "eslint": "^10",
    "factorio-raw-types": "^0.4",
    "happy-dom": "^20",
    "oxfmt": "^0.70",
    "sharp": "^0.35",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-bundle-analyzer": "^1",
    "vite-plugin-preload": "^0.7",
    "vitest": "^5"
  }
}
